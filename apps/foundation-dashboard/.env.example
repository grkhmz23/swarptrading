# SwarpPay dashboard — public build-time configuration.
# Every value here is inlined into the browser bundle: never put secrets in it.
# `next build` fails if a REQUIRED value is missing.

# REQUIRED. Backend API origin (https:// in production), no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# REQUIRED. Solana cluster the custodial backend operates on: devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# SWARP token mint address on the cluster above.
NEXT_PUBLIC_SWARP_TOKEN_MINT=SWRP2DA2zGT9q6MvSGanDiTMoiJqqcgmDnbkPJekp3e

# MoonPay publishable key (pk_test_… for sandbox, pk_live_… for production).
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=

# Site hosting the Terms and Privacy pages linked from onboarding.
NEXT_PUBLIC_LEGAL_SITE_URL=https://www.swarpfoundation.com

# Optional. SWARP presale price in USD shown on the SWARP token card (hidden when empty).
NEXT_PUBLIC_SWARP_PRESALE_PRICE_USD=
