# Copy to .env (development) or set in the build environment (Amplify, CI).
# Only VITE_* variables are read, and they are embedded in the public bundle:
# never put secrets here.

# Origin of the backend API, without a path. Required for production builds,
# which fail if it is missing or not https. Development defaults to
# http://localhost:3000. The value below is a placeholder.
VITE_ADMIN_API_URL=https://api.example.com

# Path prefix of the admin REST resources on that API (default /admin-api).
VITE_ADMIN_API_BASE_PATH=/admin-api

# Port for `npm run dev` / `npm run preview` (default 3002). The dev server
# listens on localhost only.
VITE_DEV_PORT=3002
