# SwarpPay API configuration. Copy to .env and fill in; the server refuses to
# start and lists every missing or invalid value. Never commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# true behind a load balancer / reverse proxy so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# REQUIRED. PostgreSQL 14+ connection string.
DATABASE_URL=postgres://swarp:swarp_local_dev@localhost:5432/swarp_api
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# REQUIRED. Comma-separated browser origins allowed to call the API (dashboard, admin).
CORS_ORIGINS=http://localhost:3000

# REQUIRED. Signs access tokens. At least 32 characters: `openssl rand -hex 32`.
JWT_SECRET=
JWT_ISSUER=swarp-api
JWT_AUDIENCE=swarp-app
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production. false only for http://localhost development.
COOKIE_SECURE=false
# Optional, e.g. .swarppay.com so app. and api. share the refresh cookie.
COOKIE_DOMAIN=

# REQUIRED. Server-side secret mixed into every PIN hash. Different from JWT_SECRET,
# at least 32 characters, kept out of the database and backups. Rotating it invalidates every PIN.
PIN_PEPPER=
SESSION_UNLOCK_TTL_SECONDS=43200
PIN_STEP_UP_TTL_SECONDS=300
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_BASE_MINUTES=15

# REQUIRED. Twilio Verify: Account SID and auth token (Console → Account info), and the
# Verify Service SID (Console → Verify → Services).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SMS abuse limits (per number per 10 minutes, per number per day, per IP per hour).
OTP_MAX_PER_PHONE_10_MIN=3
OTP_MAX_PER_PHONE_DAY=10
OTP_MAX_PER_IP_HOUR=20
# Comma-separated ISO country codes SMS codes may be sent to (empty = all). Restricting this
# is the main defence against SMS pumping fraud.
OTP_ALLOWED_COUNTRIES=
