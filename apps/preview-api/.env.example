# SwarpPay preview API — sample data only. It cannot move funds.
# Every request fails with 500 until the REQUIRED values are set.

# REQUIRED. Signs preview session tokens. At least 32 characters, e.g. `openssl rand -hex 32`.
PREVIEW_JWT_SECRET=

# REQUIRED. 6 digits. Your team enters it as the SMS code and as the wallet PIN.
PREVIEW_ACCESS_CODE=

# REQUIRED. Comma-separated origins allowed to call this API (the dashboard's URL).
# One `*` per entry matches a single DNS label part, for Vercel preview URLs:
#   https://swarp-dashboard.vercel.app,https://swarp-dashboard-*.vercel.app
PREVIEW_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Receive address shown for the sample wallet. Leave empty to use a
# generated address nobody holds keys for — never send real funds to it.
PREVIEW_WALLET_ADDRESS=

# Optional. SWARP mint shown in sample balances; match the dashboard's NEXT_PUBLIC_SWARP_TOKEN_MINT.
PREVIEW_SWARP_MINT=SWRP2DA2zGT9q6MvSGanDiTMoiJqqcgmDnbkPJekp3e
